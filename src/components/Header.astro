---
import { SITE } from "@/config";
import CardNav, { type CardNavItem } from "@/components/CardNav.astro";

/** CardNav ≤3 cards — light glass palette (AquaLeap ink / aqua) */
const cardNavItems: CardNavItem[] = [
  {
    label: "导航",
    bgColor: "rgb(232 238 246 / 0.95)",
    textColor: "#121c29",
    links: [
      { label: "首页", href: "/", ariaLabel: "返回首页" },
      { label: "关于", href: "/about/", ariaLabel: "关于我" },
      { label: "简历", href: "/resume/", ariaLabel: "在线简历" },
    ],
  },
  {
    label: "作品",
    bgColor: "rgb(47 168 154 / 0.12)",
    textColor: "#1c6b62",
    links: [
      { label: "项目", href: "/projects/", ariaLabel: "项目作品集" },
      { label: "博客", href: "/blog/", ariaLabel: "技术博客" },
      { label: "实验室", href: "/lab/", ariaLabel: "实验室 Demo" },
    ],
  },
  {
    label: "资源",
    bgColor: "rgb(208 219 234 / 0.75)",
    textColor: "#1e2b3c",
    links: [
      { label: "资源库", href: "/resources/", ariaLabel: "个人资源库" },
      { label: "工具", href: "/tools/", ariaLabel: "在线工具" },
      {
        label: "GitHub",
        href: SITE.github,
        ariaLabel: "GitHub 主页",
        external: true,
      },
    ],
  },
];
---

{/*
  React Bits CardNav is a floating overlay (official: absolute; we use fixed).
  It does not reserve layout height — page content pads under the closed bar only.
*/}
<CardNav
  logo="/assets/logo-128.png?v=20260723b"
  logoAlt={SITE.title}
  items={cardNavItems}
  baseColor="#fff"
  menuColor="#111"
  buttonBgColor="#111"
  buttonTextColor="#fff"
  ctaLabel="GitHub"
  ctaHref={SITE.github}
  ease="power3.out"
/>

<script>
  const themeBtn = document.getElementById("theme-toggle");
  themeBtn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
