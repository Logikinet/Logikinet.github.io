---
/**
 * Travel2-style stacked project cards for homepage “更多项目”.
 * Cover images live under /assets/projects/<id>.jpg
 */
import {
  type Project,
  getExposedRepositoryUrl,
  getProviderLabel,
  repositoryLabel,
  toPageSafeProject,
} from "@/data/projects";
import { projectCoverAlt, projectCoverUrl } from "@/data/projects/covers";

interface Props {
  projects: Project[];
}

const { projects: rawProjects } = Astro.props;
const projects = rawProjects.map(toPageSafeProject);
---

{
  projects.length > 0 && (
    <div class="project-stack" data-project-stack>
      <div class="project-stack-stage" aria-roledescription="carousel" aria-label="更多项目轮播">
        {/* Light glass stage — matches site card / band surfaces */}
        <div class="project-stack-glow" aria-hidden="true"></div>
        <div class="project-stack-grid" aria-hidden="true"></div>

        <div class="project-stack-track">
          {projects.map((project, index) => {
            const repoUrl = getExposedRepositoryUrl(project);
            const repoLabel = repositoryLabel(project);
            const providerLabel = getProviderLabel(project);
            const cover = projectCoverUrl(project.id);
            const stack = project.stack.filter((t) => t && t !== "整理中").slice(0, 4);

            return (
              <article
                class="project-stack-card"
                data-stack-card
                data-index={index}
                data-offset={index}
                aria-hidden={index !== 0 ? "true" : "false"}
                aria-label={project.title}
              >
                <div class="project-stack-media">
                  {
                    cover ? (
                      <img
                        src={cover}
                        alt={projectCoverAlt(project.title)}
                        width="640"
                        height="480"
                        loading={index === 0 ? "eager" : "lazy"}
                        decoding="async"
                        class="project-stack-img"
                      />
                    ) : (
                      <div class="project-stack-img project-stack-img-fallback" aria-hidden="true" />
                    )
                  }
                  <div class="project-stack-media-fade" aria-hidden="true"></div>
                </div>

                <div class="project-stack-body">
                  <div class="project-stack-meta">
                    {project.featured && <span class="chip-accent">精选</span>}
                    <span class="chip">{project.status}</span>
                    <span class="chip">{repoLabel}</span>
                    {project.year && (
                      <span class="card-meta ml-auto font-mono">{project.year}</span>
                    )}
                  </div>

                  <h3 class="project-stack-title">
                    <a
                      href={`/projects/${project.id}/`}
                      class="no-underline"
                      tabindex={index === 0 ? 0 : -1}
                    >
                      {project.title}
                    </a>
                  </h3>

                  <p class="project-stack-summary">{project.summary}</p>

                  {stack.length > 0 && (
                    <div class="project-stack-tags">
                      {stack.map((tech) => (
                        <span class="chip">{tech}</span>
                      ))}
                    </div>
                  )}

                  <div class="project-stack-actions">
                    <a
                      href={`/projects/${project.id}/`}
                      class="btn-primary !px-3.5 !py-2 text-xs"
                      tabindex={index === 0 ? 0 : -1}
                    >
                      查看详情
                    </a>
                    {repoUrl ? (
                      <a
                        href={repoUrl}
                        class="btn-ghost !px-3 !py-2 text-xs"
                        target="_blank"
                        rel="noopener noreferrer"
                        tabindex={index === 0 ? 0 : -1}
                      >
                        {project.repositoryStatus === "private"
                          ? `私有 ${providerLabel}`
                          : providerLabel}
                      </a>
                    ) : null}
                    {project.demo ? (
                      project.demo.startsWith("/") ? (
                        <a
                          href={project.demo}
                          class="btn-ghost !px-3 !py-2 text-xs"
                          tabindex={index === 0 ? 0 : -1}
                        >
                          {project.demo.startsWith("/tools/") ? "打开工具" : "打开"}
                        </a>
                      ) : (
                        <a
                          href={project.demo}
                          class="btn-ghost !px-3 !py-2 text-xs"
                          target="_blank"
                          rel="noopener noreferrer"
                          tabindex={index === 0 ? 0 : -1}
                        >
                          Demo
                        </a>
                      )
                    ) : null}
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="project-stack-controls">
          <button
            type="button"
            class="project-stack-btn"
            data-stack-prev
            aria-label="上一个项目"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
            </svg>
          </button>
          <button
            type="button"
            class="project-stack-btn"
            data-stack-next
            aria-label="下一个项目"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
            </svg>
          </button>
        </div>

        <div class="project-stack-dots" role="tablist" aria-label="项目指示">
          {projects.map((p, i) => (
            <button
              type="button"
              class="project-stack-dot"
              data-stack-dot
              data-index={i}
              aria-label={`显示 ${p.title}`}
              aria-current={i === 0 ? "true" : undefined}
            />
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  .project-stack {
    width: 100%;
  }

  /* Light glass stage — same family as .card / .band / hero */
  .project-stack-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgb(208 219 234 / 0.75);
    background:
      radial-gradient(ellipse 70% 55% at 18% 0%, rgb(47 168 154 / 0.1), transparent 55%),
      radial-gradient(ellipse 55% 45% at 88% 12%, rgb(90 113 140 / 0.07), transparent 55%),
      linear-gradient(180deg, rgb(255 255 255 / 0.92) 0%, rgb(245 247 251 / 0.88) 100%);
    min-height: 28rem;
    box-shadow: var(--shadow-card);
  }

  :global(.dark) .project-stack-stage {
    border-color: rgb(52 70 89 / 0.55);
    background:
      radial-gradient(ellipse 70% 55% at 15% 0%, rgb(47 168 154 / 0.1), transparent 55%),
      radial-gradient(ellipse 50% 40% at 90% 10%, rgb(80 120 170 / 0.1), transparent 55%),
      linear-gradient(180deg, rgb(18 28 41 / 0.72) 0%, rgb(12 18 27 / 0.85) 100%);
    box-shadow: var(--shadow-card-dark);
  }

  .project-stack-glow {
    position: absolute;
    inset: -20% 10% auto;
    height: 55%;
    z-index: 0;
    background: radial-gradient(ellipse at center, rgb(47 168 154 / 0.12), transparent 70%);
    pointer-events: none;
  }

  .project-stack-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.4;
    background-image:
      linear-gradient(to right, rgb(90 113 140 / 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(90 113 140 / 0.07) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 15%, transparent 75%);
    pointer-events: none;
  }

  :global(.dark) .project-stack-grid {
    opacity: 0.28;
    background-image:
      linear-gradient(to right, rgb(126 212 200 / 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(126 212 200 / 0.06) 1px, transparent 1px);
  }

  .project-stack-track {
    position: relative;
    z-index: 1;
    height: 26.5rem;
    margin: 1.1rem auto 3.4rem;
    max-width: 58rem;
  }

  .project-stack-card {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(17.25rem, 78vw);
    display: flex;
    flex-direction: column;
    border-radius: 1.15rem;
    overflow: hidden;
    background: rgb(255 255 255 / 0.96);
    border: 1px solid rgb(208 219 234 / 0.8);
    box-shadow: var(--shadow-card);
    transform: translateX(-50%) scale(0.82);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      filter 0.35s ease,
      box-shadow 0.35s ease;
    will-change: transform, opacity;
  }

  :global(.dark) .project-stack-card {
    background: rgb(18 28 41 / 0.94);
    border-color: rgb(52 70 89 / 0.55);
    box-shadow: var(--shadow-card-dark);
  }

  .project-stack-card[data-offset="0"] {
    z-index: 5;
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) scale(1);
    box-shadow: var(--shadow-card-hover);
    border-color: rgb(47 168 154 / 0.28);
  }

  :global(.dark) .project-stack-card[data-offset="0"] {
    box-shadow: var(--shadow-card-dark-hover);
    border-color: rgb(47 168 154 / 0.28);
  }

  .project-stack-card[data-offset="-1"] {
    z-index: 4;
    opacity: 0.92;
    pointer-events: auto;
    transform: translateX(calc(-50% - 8.25rem)) scale(0.9) rotate(-2.5deg);
  }

  .project-stack-card[data-offset="1"] {
    z-index: 4;
    opacity: 0.92;
    pointer-events: auto;
    transform: translateX(calc(-50% + 8.25rem)) scale(0.9) rotate(2.5deg);
  }

  .project-stack-card[data-offset="-2"] {
    z-index: 3;
    opacity: 0.62;
    transform: translateX(calc(-50% - 14.5rem)) scale(0.8) rotate(-4deg);
  }

  .project-stack-card[data-offset="2"] {
    z-index: 3;
    opacity: 0.62;
    transform: translateX(calc(-50% + 14.5rem)) scale(0.8) rotate(4deg);
  }

  .project-stack-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgb(232 238 246 / 0.65);
  }

  :global(.dark) .project-stack-media {
    background: rgb(23 34 49 / 0.9);
  }

  .project-stack-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .project-stack-img-fallback {
    background:
      radial-gradient(ellipse 70% 60% at 30% 20%, rgb(47 168 154 / 0.2), transparent 55%),
      linear-gradient(160deg, rgb(232 238 246) 0%, rgb(245 247 251) 100%);
  }

  .project-stack-card[data-offset="0"] .project-stack-img {
    transform: scale(1.03);
  }

  .project-stack-media-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 42%;
    background: linear-gradient(to top, rgb(255 255 255 / 0.98), transparent);
    pointer-events: none;
  }

  :global(.dark) .project-stack-media-fade {
    background: linear-gradient(to top, rgb(18 28 41 / 0.98), transparent);
  }

  .project-stack-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.8rem 1rem 1rem;
  }

  .project-stack-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .project-stack-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--color-ink-900);
    margin: 0;
  }

  :global(.dark) .project-stack-title {
    color: var(--color-ink-50);
  }

  .project-stack-title a {
    color: inherit;
  }

  .project-stack-title a:hover {
    color: var(--color-aqua-600);
  }

  :global(.dark) .project-stack-title a:hover {
    color: var(--color-aqua-300);
  }

  .project-stack-summary {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-ink-600);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.dark) .project-stack-summary {
    color: var(--color-ink-300);
  }

  .project-stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .project-stack-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.2rem;
    padding-top: 0.6rem;
    border-top: 1px solid rgb(232 238 246 / 0.95);
  }

  :global(.dark) .project-stack-actions {
    border-top-color: rgb(52 70 89 / 0.55);
  }

  .project-stack-controls {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 6;
    display: flex;
    gap: 0.4rem;
  }

  .project-stack-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 999px;
    border: 1px solid rgb(208 219 234 / 0.9);
    background: rgb(255 255 255 / 0.88);
    color: var(--color-ink-700);
    box-shadow: 0 2px 8px rgb(18 28 41 / 0.06);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.15s ease;
  }

  .project-stack-btn:hover {
    background: white;
    border-color: rgb(47 168 154 / 0.45);
    color: var(--color-aqua-700);
  }

  .project-stack-btn:active {
    transform: scale(0.96);
  }

  :global(.dark) .project-stack-btn {
    background: rgb(18 28 41 / 0.85);
    border-color: rgb(52 70 89 / 0.65);
    color: var(--color-ink-100);
  }

  :global(.dark) .project-stack-btn:hover {
    border-color: rgb(47 168 154 / 0.4);
    color: var(--color-aqua-300);
  }

  .project-stack-btn svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .project-stack-dots {
    position: absolute;
    left: 50%;
    bottom: 1.05rem;
    transform: translateX(-50%);
    z-index: 6;
    display: flex;
    gap: 0.35rem;
  }

  .project-stack-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: rgb(164 181 203 / 0.55);
    cursor: pointer;
    transition: width 0.25s ease, background 0.2s ease;
  }

  .project-stack-dot[aria-current="true"] {
    width: 1.1rem;
    background: var(--color-aqua-500);
  }

  :global(.dark) .project-stack-dot {
    background: rgb(90 113 140 / 0.55);
  }

  :global(.dark) .project-stack-dot[aria-current="true"] {
    background: var(--color-aqua-400);
  }

  @media (max-width: 640px) {
    .project-stack-stage {
      min-height: 26rem;
    }

    .project-stack-track {
      height: 24.5rem;
      margin-bottom: 3.15rem;
    }

    .project-stack-card {
      width: min(16.25rem, 84vw);
    }

    .project-stack-card[data-offset="-1"] {
      transform: translateX(calc(-50% - 5.25rem)) scale(0.88) rotate(-2deg);
    }

    .project-stack-card[data-offset="1"] {
      transform: translateX(calc(-50% + 5.25rem)) scale(0.88) rotate(2deg);
    }

    .project-stack-card[data-offset="-2"],
    .project-stack-card[data-offset="2"] {
      opacity: 0;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-stack-card,
    .project-stack-img,
    .project-stack-dot {
      transition: none;
    }
  }
</style>

<script>
  function wrapOffset(i: number, active: number, n: number): number {
    const raw = ((i - active) % n + n) % n;
    const signed = raw > n / 2 ? raw - n : raw;
    // Hide cards beyond ±2 (no matching CSS → opacity 0 via default)
    if (Math.abs(signed) > 2) return signed > 0 ? 3 : -3;
    return signed;
  }

  function initStack(root: HTMLElement) {
    if (root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-stack-card]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-stack-dot]"));
    const prev = root.querySelector<HTMLButtonElement>("[data-stack-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-stack-next]");
    if (cards.length === 0) return;

    let active = 0;
    const n = cards.length;

    const render = () => {
      cards.forEach((card, i) => {
        const offset = wrapOffset(i, active, n);
        card.dataset.offset = String(offset);
        card.setAttribute("aria-hidden", i === active ? "false" : "true");
        card.querySelectorAll("a").forEach((a) => {
          if (i === active) a.removeAttribute("tabindex");
          else a.setAttribute("tabindex", "-1");
        });
      });
      dots.forEach((dot, i) => {
        if (i === active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    const go = (index: number) => {
      active = ((index % n) + n) % n;
      render();
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer: ReturnType<typeof setInterval> | null = null;

    const stopAuto = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };
    const startAuto = () => {
      stopAuto();
      if (reduceMotion || n < 2) return;
      timer = setInterval(() => go(active + 1), 5500);
    };

    prev?.addEventListener("click", () => {
      go(active - 1);
      startAuto();
    });
    next?.addEventListener("click", () => {
      go(active + 1);
      startAuto();
    });
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const i = Number(dot.dataset.index);
        if (!Number.isNaN(i)) {
          go(i);
          startAuto();
        }
      });
    });

    // Click side cards to focus them
    cards.forEach((card, i) => {
      card.addEventListener("click", (e) => {
        if (i === active) return;
        e.preventDefault();
        go(i);
        startAuto();
      });
    });

    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        go(active - 1);
        startAuto();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        go(active + 1);
        startAuto();
      }
    });
    root.setAttribute("tabindex", "0");

    // Touch swipe
    let touchX = 0;
    root.addEventListener(
      "touchstart",
      (e) => {
        touchX = e.changedTouches[0]?.clientX ?? 0;
        stopAuto();
      },
      { passive: true },
    );
    root.addEventListener(
      "touchend",
      (e) => {
        const x = e.changedTouches[0]?.clientX ?? touchX;
        const dx = x - touchX;
        if (Math.abs(dx) >= 40) {
          if (dx < 0) go(active + 1);
          else go(active - 1);
        }
        startAuto();
      },
      { passive: true },
    );

    root.addEventListener("mouseenter", stopAuto);
    root.addEventListener("mouseleave", startAuto);
    root.addEventListener("focusin", stopAuto);
    root.addEventListener("focusout", startAuto);

    render();
    startAuto();
  }

  function boot() {
    document.querySelectorAll<HTMLElement>("[data-project-stack]").forEach(initStack);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
  document.addEventListener("astro:page-load", boot);
</script>
