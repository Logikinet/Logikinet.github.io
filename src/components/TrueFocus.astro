---
/**
 * Vanilla port of React Bits TrueFocus.
 * Word-by-word focus frame + blur; frame motion via GSAP (no React/motion dependency).
 */
interface Props {
  sentence?: string;
  separator?: string;
  manualMode?: boolean;
  blurAmount?: number;
  borderColor?: string;
  glowColor?: string;
  animationDuration?: number;
  pauseBetweenAnimations?: number;
  className?: string;
  wordClassName?: string;
}

const {
  sentence = "True Focus",
  separator = " ",
  manualMode = false,
  blurAmount = 4,
  borderColor = "var(--color-aqua-500)",
  glowColor = "rgb(47 168 154 / 0.55)",
  animationDuration = 0.55,
  pauseBetweenAnimations = 1.1,
  className = "",
  wordClassName = "",
} = Astro.props;

const words = sentence.split(separator).filter((w) => w.length > 0);
---

<span
  class:list={["focus-container", className]}
  data-true-focus
  data-manual={manualMode ? "1" : "0"}
  data-blur={blurAmount}
  data-border-color={borderColor}
  data-glow-color={glowColor}
  data-duration={animationDuration}
  data-pause={pauseBetweenAnimations}
  style={`--border-color: ${borderColor}; --glow-color: ${glowColor}; --tf-duration: ${animationDuration}s; --tf-blur: ${blurAmount}px;`}
>
  {
    words.map((word, index) => (
      <span
        class:list={[
          "focus-word",
          wordClassName,
          manualMode ? "manual" : "",
          !manualMode && index === 0 ? "active" : "",
        ]}
        data-focus-word
        data-index={index}
        style={
          !manualMode && index === 0
            ? "filter: blur(0px)"
            : `filter: blur(${blurAmount}px)`
        }
      >
        {word}
      </span>
    ))
  }
  <span class="focus-frame" data-focus-frame aria-hidden="true">
    <span class="corner top-left"></span>
    <span class="corner top-right"></span>
    <span class="corner bottom-left"></span>
    <span class="corner bottom-right"></span>
  </span>
</span>

<style>
  .focus-container {
    position: relative;
    display: inline-flex;
    gap: 0.35em;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    outline: none;
    user-select: none;
  }

  .focus-word {
    position: relative;
    cursor: default;
    outline: none;
    user-select: none;
    transition:
      filter var(--tf-duration, 0.55s) ease,
      color 0.3s ease;
    will-change: filter;
  }

  .focus-word.manual {
    cursor: pointer;
  }

  .focus-word.active {
    filter: blur(0) !important;
  }

  .focus-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    box-sizing: content-box;
    border: none;
    opacity: 0;
  }

  .corner {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    border: 2.5px solid var(--border-color, #2fa89a);
    filter: drop-shadow(0 0 5px var(--glow-color, rgb(47 168 154 / 0.55)));
    border-radius: 2px;
  }

  .top-left {
    top: -8px;
    left: -8px;
    border-right: none;
    border-bottom: none;
  }

  .top-right {
    top: -8px;
    right: -8px;
    border-left: none;
    border-bottom: none;
  }

  .bottom-left {
    bottom: -8px;
    left: -8px;
    border-right: none;
    border-top: none;
  }

  .bottom-right {
    bottom: -8px;
    right: -8px;
    border-left: none;
    border-top: none;
  }

  @media (min-width: 640px) {
    .corner {
      width: 0.85rem;
      height: 0.85rem;
      border-width: 3px;
    }
    .top-left,
    .top-right {
      top: -10px;
    }
    .bottom-left,
    .bottom-right {
      bottom: -10px;
    }
    .top-left,
    .bottom-left {
      left: -10px;
    }
    .top-right,
    .bottom-right {
      right: -10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .focus-word {
      filter: none !important;
      transition: none;
    }
    .focus-frame {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  type Root = HTMLElement;

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function initOne(root: Root) {
    if (root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const words = Array.from(root.querySelectorAll<HTMLElement>("[data-focus-word]"));
    const frame = root.querySelector<HTMLElement>("[data-focus-frame]");
    if (!words.length || !frame) return;

    const manual = root.dataset.manual === "1";
    const blurAmount = Number(root.dataset.blur || 4);
    const duration = Number(root.dataset.duration || 0.55);
    const pause = Number(root.dataset.pause || 1.1);
    const borderColor = root.dataset.borderColor || "var(--color-aqua-500)";
    const glowColor = root.dataset.glowColor || "rgb(47 168 154 / 0.55)";

    root.style.setProperty("--border-color", borderColor);
    root.style.setProperty("--glow-color", glowColor);

    if (prefersReducedMotion()) {
      words.forEach((w) => {
        w.style.filter = "none";
        w.classList.add("active");
      });
      return;
    }

    let currentIndex = 0;
    let lastActiveIndex = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const applyBlur = (active: number) => {
      words.forEach((w, i) => {
        const isActive = i === active;
        w.classList.toggle("active", isActive);
        w.style.filter = isActive ? "blur(0px)" : `blur(${blurAmount}px)`;
        w.style.transition = `filter ${duration}s ease`;
      });
    };

    const moveFrame = (active: number) => {
      const word = words[active];
      if (!word) return;
      const parentRect = root.getBoundingClientRect();
      const activeRect = word.getBoundingClientRect();
      const x = activeRect.left - parentRect.left;
      const y = activeRect.top - parentRect.top;
      const width = activeRect.width;
      const height = activeRect.height;

      gsap.to(frame, {
        x,
        y,
        width,
        height,
        opacity: 1,
        duration,
        ease: "power2.out",
        overwrite: true,
      });
    };

    const setActive = (index: number) => {
      currentIndex = index;
      applyBlur(index);
      moveFrame(index);
    };

    // initial layout after fonts
    const boot = () => {
      gsap.set(frame, { x: 0, y: 0, width: 0, height: 0, opacity: 0 });
      setActive(0);
    };

    if (document.fonts?.ready) {
      document.fonts.ready.then(boot);
    } else {
      requestAnimationFrame(boot);
    }

    if (!manual) {
      timer = setInterval(
        () => {
          setActive((currentIndex + 1) % words.length);
        },
        (duration + pause) * 1000,
      );
    } else {
      words.forEach((w, index) => {
        w.addEventListener("mouseenter", () => {
          lastActiveIndex = currentIndex;
          setActive(index);
        });
        w.addEventListener("mouseleave", () => {
          setActive(lastActiveIndex);
        });
      });
    }

    const onResize = () => moveFrame(currentIndex);
    window.addEventListener("resize", onResize);

    window.addEventListener(
      "pagehide",
      () => {
        if (timer) clearInterval(timer);
        window.removeEventListener("resize", onResize);
        gsap.killTweensOf(frame);
      },
      { once: true },
    );
  }

  function bootAll() {
    document.querySelectorAll<Root>("[data-true-focus]").forEach(initOne);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootAll);
  } else {
    bootAll();
  }
  document.addEventListener("astro:page-load", bootAll);
</script>
