---
/**
 * Vanilla port of React Bits TrueFocus (JS + CSS).
 * Frame motion uses GSAP instead of motion/react (site is Astro, not React).
 * @see https://reactbits.dev — TrueFocus
 */
interface Props {
  sentence?: string;
  separator?: string;
  manualMode?: boolean;
  blurAmount?: number;
  borderColor?: string;
  glowColor?: string;
  animationDuration?: number;
  pauseBetweenAnimations?: number;
  className?: string;
  wordClassName?: string;
}

const {
  sentence = "True Focus",
  separator = " ",
  manualMode = false,
  blurAmount = 5,
  borderColor = "var(--color-aqua-500)",
  glowColor = "rgb(47 168 154 / 0.6)",
  animationDuration = 0.5,
  pauseBetweenAnimations = 1,
  className = "",
  wordClassName = "",
} = Astro.props;

const words = sentence.split(separator).filter((w) => w.length > 0);
---

<div
  class:list={["focus-container", className]}
  data-true-focus
  data-manual={manualMode ? "1" : "0"}
  data-blur={String(blurAmount)}
  data-border-color={borderColor}
  data-glow-color={glowColor}
  data-duration={String(animationDuration)}
  data-pause={String(pauseBetweenAnimations)}
  style={`--border-color: ${borderColor}; --glow-color: ${glowColor}; --tf-duration: ${animationDuration}s;`}
>
  {
    words.map((word, index) => (
      <span
        class:list={[
          "focus-word",
          wordClassName,
          manualMode && "manual",
          !manualMode && index === 0 && "active",
        ]}
        data-focus-word
        data-index={String(index)}
        style={`filter: blur(${!manualMode && index === 0 ? 0 : blurAmount}px); transition: filter ${animationDuration}s ease; --border-color: ${borderColor}; --glow-color: ${glowColor};`}
      >
        {word}
      </span>
    ))
  }

  <div class="focus-frame" data-focus-frame aria-hidden="true">
    <span class="corner top-left"></span>
    <span class="corner top-right"></span>
    <span class="corner bottom-left"></span>
    <span class="corner bottom-right"></span>
  </div>
</div>

<style>
  /* React Bits TrueFocus.css (adapted for hero inline layout) */
  .focus-container {
    position: relative;
    display: flex;
    gap: 0.35em;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    outline: none;
    user-select: none;
  }

  .focus-word {
    position: relative;
    cursor: default;
    transition:
      filter 0.3s ease,
      color 0.3s ease;
    outline: none;
    user-select: none;
    will-change: filter;
  }

  .focus-word.manual {
    cursor: pointer;
  }

  .focus-word.active {
    filter: blur(0) !important;
  }

  .focus-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    box-sizing: content-box;
    border: none;
    opacity: 0;
    will-change: left, top, width, height, opacity;
  }

  .corner {
    position: absolute;
    width: 1rem;
    height: 1rem;
    border: 3px solid var(--border-color, #2fa89a);
    filter: drop-shadow(0px 0px 4px var(--glow-color, var(--border-color, #2fa89a)));
    border-radius: 3px;
    transition: none;
  }

  .top-left {
    top: -10px;
    left: -10px;
    border-right: none;
    border-bottom: none;
  }

  .top-right {
    top: -10px;
    right: -10px;
    border-left: none;
    border-bottom: none;
  }

  .bottom-left {
    bottom: -10px;
    left: -10px;
    border-right: none;
    border-top: none;
  }

  .bottom-right {
    bottom: -10px;
    right: -10px;
    border-left: none;
    border-top: none;
  }

  @media (max-width: 639px) {
    .corner {
      width: 0.75rem;
      height: 0.75rem;
      border-width: 2.5px;
    }
    .top-left,
    .top-right {
      top: -8px;
    }
    .bottom-left,
    .bottom-right {
      bottom: -8px;
    }
    .top-left,
    .bottom-left {
      left: -8px;
    }
    .top-right,
    .bottom-right {
      right: -8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .focus-word {
      filter: none !important;
      transition: none !important;
    }
    .focus-frame {
      display: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function initOne(root: HTMLElement) {
    if (root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const words = Array.from(root.querySelectorAll<HTMLElement>("[data-focus-word]"));
    const frame = root.querySelector<HTMLElement>("[data-focus-frame]");
    if (!words.length || !frame) return;

    const manual = root.dataset.manual === "1";
    const blurAmount = Number(root.dataset.blur ?? 5);
    const duration = Number(root.dataset.duration ?? 0.5);
    const pause = Number(root.dataset.pause ?? 1);
    const borderColor = root.dataset.borderColor || "var(--color-aqua-500)";
    const glowColor = root.dataset.glowColor || "rgb(47 168 154 / 0.6)";

    root.style.setProperty("--border-color", borderColor);
    root.style.setProperty("--glow-color", glowColor);

    if (prefersReducedMotion()) {
      words.forEach((w) => {
        w.style.filter = "none";
        w.classList.add("active");
      });
      return;
    }

    let currentIndex = 0;
    let lastActiveIndex = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const applyBlur = (active: number) => {
      words.forEach((w, i) => {
        const isActive = i === active;
        w.classList.toggle("active", isActive);
        w.style.filter = isActive ? "blur(0px)" : `blur(${blurAmount}px)`;
        w.style.transition = `filter ${duration}s ease`;
      });
    };

    /** Match motion.div animate left/top/size (not transform-only) */
    const moveFrame = (active: number) => {
      const word = words[active];
      if (!word) return;
      const parentRect = root.getBoundingClientRect();
      const activeRect = word.getBoundingClientRect();
      const x = activeRect.left - parentRect.left + root.scrollLeft;
      const y = activeRect.top - parentRect.top + root.scrollTop;
      const width = activeRect.width;
      const height = activeRect.height;

      gsap.to(frame, {
        left: x,
        top: y,
        width,
        height,
        opacity: 1,
        duration,
        ease: "power2.out",
        overwrite: true,
      });
    };

    const setActive = (index: number) => {
      currentIndex = ((index % words.length) + words.length) % words.length;
      applyBlur(currentIndex);
      // double-rAF so layout is settled after class/filter change
      requestAnimationFrame(() => {
        requestAnimationFrame(() => moveFrame(currentIndex));
      });
    };

    const boot = () => {
      gsap.set(frame, { left: 0, top: 0, width: 0, height: 0, opacity: 0, x: 0, y: 0 });
      setActive(0);
    };

    const startAuto = () => {
      if (manual || timer) return;
      timer = setInterval(
        () => setActive(currentIndex + 1),
        (duration + pause) * 1000,
      );
    };

    const whenReady = () => {
      boot();
      if (!manual) startAuto();
    };

    if (document.fonts?.ready) {
      document.fonts.ready.then(whenReady).catch(whenReady);
    } else {
      requestAnimationFrame(whenReady);
    }

    if (manual) {
      words.forEach((w, index) => {
        w.addEventListener("mouseenter", () => {
          lastActiveIndex = currentIndex;
          setActive(index);
        });
        w.addEventListener("mouseleave", () => {
          setActive(lastActiveIndex);
        });
      });
    }

    const onResize = () => moveFrame(currentIndex);
    window.addEventListener("resize", onResize);

    window.addEventListener(
      "pagehide",
      () => {
        if (timer) clearInterval(timer);
        window.removeEventListener("resize", onResize);
        gsap.killTweensOf(frame);
      },
      { once: true },
    );
  }

  function bootAll() {
    document.querySelectorAll<HTMLElement>("[data-true-focus]").forEach(initOne);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootAll);
  } else {
    bootAll();
  }
  document.addEventListener("astro:page-load", bootAll);
</script>
