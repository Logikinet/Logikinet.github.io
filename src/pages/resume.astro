---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE, FOCUS_AREAS, ACHIEVEMENTS } from "@/config";
import { getFeaturedProjects } from "@/data/projects";

const featuredProjects = getFeaturedProjects(8);
const resumePdf = SITE.resumePdf;
---

<BaseLayout title="在线简历" description={`${SITE.name}的在线简历：AI Agent / Harness、FDE 交付与可核验成果摘要。`}>
  <div class="container-page section-space">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="label-meta">Resume</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{SITE.name}</h1>
        <p class="mt-2 text-ink-600 dark:text-ink-300">AI Agent / Harness · FDE 前线部署 · {SITE.title}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href={resumePdf} class="btn-primary" download target="_blank" rel="noopener noreferrer">下载 PDF 简历</a>
        <a href={SITE.github} class="btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/about/" class="btn-ghost">关于我</a>
      </div>
    </div>

    <section class="mt-10 card">
      <h2 class="text-xl font-semibold">简介</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        计算机本科在读，面向 AI Agent / Harness 与 FDE。擅长 Function Calling / Skills、Token 治理与评测回归，以及 PoC → 联调验收交付；兼具软硬件与 Docker 经验。可立即全职实习至转正，接受驻场 / 出差。
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        同时关注仓颉语言与鸿蒙开发、AI 应用落地，以及 ROS 机器人与智能硬件。偏好把 Agent 做成可回归系统（Loop / Tools / Harness / Eval），交付物默认带复现路径。
      </p>
      <p class="mt-4">
        <a href={resumePdf} class="section-link text-sm" target="_blank" rel="noopener noreferrer">打开完整 PDF 简历（Kami 电子版）→</a>
      </p>
    </section>

    <section class="mt-6 card">
      <h2 class="text-xl font-semibold">方向</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          FOCUS_AREAS.map((area) => (
            <li>
              <p class="font-medium">{area.title}</p>
              <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{area.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-6 card">
      <h2 class="text-xl font-semibold">教育背景</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-700 dark:text-ink-200">
        吉林建筑科技学院 · 计算机工程与人工智能学院 · 计算机科学与技术（华为产业学院物联网方向）本科
      </p>
      <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">
        2023.09 — 2027.06 · GPA 3.5/4.0 · 专业前 10% · 连续班长
      </p>
    </section>

    <section class="mt-6 card">
      <h2 class="text-xl font-semibold">实习与交付实践</h2>
      <ul class="mt-4 space-y-4 text-sm leading-relaxed text-ink-700 dark:text-ink-200">
        <li>
          <p class="font-medium text-ink-900 dark:text-ink-50">忠航网络 · 研发助理 · 2026.02 — 2026.10</p>
          <p class="mt-1 text-ink-600 dark:text-ink-300">版本迭代支持：用例执行、配置校验、线上问题复现与联调闭环；协助接口核对与交付文档，熟悉协作与到岗节奏。</p>
        </li>
        <li>
          <p class="font-medium text-ink-900 dark:text-ink-50">软件、小程序、网站核心开发 · 2025.06 — 至今</p>
          <p class="mt-1 text-ink-600 dark:text-ink-300">持续接单完成定制开发：餐饮点单、工具功能类微信小程序，以及管理后台 / 官网落地页等网站页面。覆盖需求沟通、页面与业务逻辑、表结构与接口联调、部署上线与问题排查，按客户验收节奏交付可上线版本。</p>
        </li>
      </ul>
    </section>

    <section class="mt-6 card">
      <h2 class="text-xl font-semibold">代表项目（简历对齐）</h2>
      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-ink-700 dark:text-ink-200">
        <li>
          <a href="/projects/cangjie-ict/" class="font-medium text-ink-900 no-underline hover:text-aqua-600 dark:text-ink-50 dark:hover:text-aqua-300">CangjieCoder / 仓颉 Agent</a>
          <span class="text-ink-500"> · ReAct / Tools / Token Harness · ICT 全球二等奖</span>
        </li>
        <li>
          <a href="/projects/new-energy-inspection/" class="font-medium text-ink-900 no-underline hover:text-aqua-600 dark:text-ink-50 dark:hover:text-aqua-300">新能智检</a>
          <span class="text-ink-500"> · 软硬件交付 · 专利受理 ×2 · 国创赛省级特等奖</span>
        </li>
        <li>
          <a href="/projects/zhidun/" class="font-medium text-ink-900 no-underline hover:text-aqua-600 dark:text-ink-50 dark:hover:text-aqua-300">智审盾</a>
          <span class="text-ink-500"> · Vue3 / FastAPI / Docker · 公开仓库</span>
        </li>
        <li>
          <a href="/projects/smart-silver/" class="font-medium text-ink-900 no-underline hover:text-aqua-600 dark:text-ink-50 dark:hover:text-aqua-300">智享银龄</a>
          <span class="text-ink-500"> · 适老化 MVP 工程骨架（非成熟上线产品）</span>
        </li>
      </ul>
    </section>

    <section class="mt-6 card">
      <h2 class="text-xl font-semibold">精选项目</h2>
      <ul class="mt-4 space-y-4">
        {
          featuredProjects.map((p) => (
              <li class="border-b border-ink-100 pb-4 last:border-0 last:pb-0 dark:border-ink-800">
                <div class="flex flex-wrap items-center gap-2">
                  <a href={`/projects/${p.id}/`} class="font-medium text-ink-900 no-underline hover:text-aqua-600 dark:text-ink-50 dark:hover:text-aqua-300">
                    {p.title}
                  </a>
                  <span class="chip">{p.status}</span>
                </div>
                <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{p.summary}</p>
                <a
                  href={`/projects/${p.id}/`}
                  class="mt-2 inline-block text-xs font-medium text-aqua-600 no-underline hover:underline dark:text-aqua-400"
                >
                  查看项目详情 →
                </a>
              </li>
            ))
        }
      </ul>
      <p class="mt-5">
        <a href="/projects/" class="section-link text-sm">浏览全部作品 →</a>
      </p>
    </section>

    <section class="mt-6 card">
      <h2 class="text-xl font-semibold">成果</h2>
      <ul class="mt-4 space-y-2">
        {
          ACHIEVEMENTS.map((item) => (
            <li class="text-sm text-ink-700 dark:text-ink-200">· {item}</li>
          ))
        }
      </ul>
      <p class="mt-4 text-xs text-ink-500">本页仅汇总已确认公开信息；竞赛与专利只写可核验结果。完整版式见 PDF。</p>
    </section>
  </div>
</BaseLayout>
