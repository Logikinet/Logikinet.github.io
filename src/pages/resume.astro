---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE, FOCUS_AREAS, ACHIEVEMENTS } from "@/config";
import { getFeaturedProjects } from "@/data/projects";

const featuredProjects = getFeaturedProjects(8);
const resumePdf = SITE.resumePdf;
---

<BaseLayout title="在线简历" description={`${SITE.name}的在线简历：AI Agent / Harness、FDE 与可核验成果摘要。`}>
  <div class="container-page section-space">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="label-meta">Resume</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{SITE.name}</h1>
        <p class="mt-2 text-ink-600 dark:text-ink-300">学生 / 独立开发者 · AI Agent / Harness · FDE · {SITE.title}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href={resumePdf} class="btn-primary" download target="_blank" rel="noopener noreferrer">下载 PDF</a>
        <a href={SITE.github} class="btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/about/" class="btn-ghost">关于我</a>
      </div>
    </div>

    <section class="mt-10 card">
      <h2 class="text-xl font-semibold">简介</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        计算机本科在读，面向 AI Agent / Harness 与 FDE。关注 Function Calling / Skills、Token 治理与评测回归，以及 PoC → 联调验收交付；兼具软硬件与 Docker 经验。同时实践仓颉与鸿蒙、AI 应用落地，以及 ROS 机器人与智能硬件。偏好可控、可靠、可复现的系统设计，重视 Token 成本与 CLI / Harness 工程优化。可立即全职实习，接受驻场 / 出差。
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        教育：吉林建筑科技学院 · 计算机科学与技术（华为产业学院物联网方向）· GPA 3.5/4.0 · 专业前 10%。交付实践含忠航网络研发助理，以及软件 / 小程序 / 网站定制开发。完整版式与项目细节见 PDF。
      </p>
    </section>

    <section class="mt-6 card">
      <h2 class="text-xl font-semibold">方向</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          FOCUS_AREAS.map((area) => (
            <li>
              <p class="font-medium">{area.title}</p>
              <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{area.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-6 card">
      <h2 class="text-xl font-semibold">精选项目</h2>
      <ul class="mt-4 space-y-4">
        {
          featuredProjects.map((p) => (
              <li class="border-b border-ink-100 pb-4 last:border-0 last:pb-0 dark:border-ink-800">
                <div class="flex flex-wrap items-center gap-2">
                  <a href={`/projects/${p.id}/`} class="font-medium text-ink-900 no-underline hover:text-aqua-600 dark:text-ink-50 dark:hover:text-aqua-300">
                    {p.title}
                  </a>
                  <span class="chip">{p.status}</span>
                </div>
                <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{p.summary}</p>
                <a
                  href={`/projects/${p.id}/`}
                  class="mt-2 inline-block text-xs font-medium text-aqua-600 no-underline hover:underline dark:text-aqua-400"
                >
                  查看项目详情 →
                </a>
              </li>
            ))
        }
      </ul>
      <p class="mt-5">
        <a href="/projects/" class="section-link text-sm">浏览全部作品 →</a>
      </p>
    </section>

    <section class="mt-6 card">
      <h2 class="text-xl font-semibold">成果</h2>
      <ul class="mt-4 space-y-2">
        {
          ACHIEVEMENTS.map((item) => (
            <li class="text-sm text-ink-700 dark:text-ink-200">· {item}</li>
          ))
        }
      </ul>
      <p class="mt-4 text-xs text-ink-500">本页仅汇总已确认公开信息，不包含未核实的工作经历或商业指标。完整简历：<a href={resumePdf} class="text-aqua-600 no-underline hover:underline dark:text-aqua-300" target="_blank" rel="noopener noreferrer">下载 PDF</a>。</p>
    </section>
  </div>
</BaseLayout>
