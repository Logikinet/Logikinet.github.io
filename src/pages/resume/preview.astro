---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config";

const resumePdfPrint = SITE.resumePdfPrint ?? SITE.resumePdf;
const previewPages = [
  { src: "/resume/preview/page-01-v3.png", alt: "简历第 1 页" },
  { src: "/resume/preview/page-02-v3.png", alt: "简历第 2 页" },
];
---

<BaseLayout
  title="简历预览"
  description={`${SITE.name} 简历在线预览。`}
>
  <div class="container-page section-space !pt-5 sm:!pt-8 !pb-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="label-meta">Resume Preview</p>
        <h1 class="mt-2 text-xl font-semibold tracking-tight sm:text-3xl">简历预览</h1>
      </div>
      <a
        href={resumePdfPrint}
        class="btn-secondary shrink-0"
        download={`王子健_简历_打印白底.pdf`}
      >
        下载
      </a>
    </div>

    <div class="mt-5 space-y-4 sm:mt-6 sm:space-y-5">
      {
        previewPages.map((page, index) => (
          <figure class="overflow-hidden rounded-xl border border-ink-200/80 bg-[#f5f4ed] shadow-sm dark:border-ink-700 sm:rounded-2xl">
            <img
              src={page.src}
              alt={page.alt}
              width="1191"
              height="1684"
              class="block h-auto w-full"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          </figure>
        ))
      }
    </div>
  </div>
</BaseLayout>
