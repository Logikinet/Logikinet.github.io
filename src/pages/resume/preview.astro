---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config";

const resumePdf = SITE.resumePdf;
const resumePdfPrint = SITE.resumePdfPrint ?? SITE.resumePdf;
const previewPages = [
  { src: "/resume/preview/page-01.png", alt: "简历第 1 页（电子版米白）" },
  { src: "/resume/preview/page-02.png", alt: "简历第 2 页（电子版米白）" },
];
---

<BaseLayout
  title="简历预览"
  description={`${SITE.name} 简历在线预览（电子版米白）；可下载打印白底版。`}
>
  <div class="container-page section-space !pt-5 sm:!pt-8 !pb-8">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <p class="label-meta">Resume Preview</p>
        <h1 class="mt-2 text-xl font-semibold tracking-tight sm:text-3xl">简历预览 · 电子版米白</h1>
        <p class="mt-1 text-sm text-ink-500 dark:text-ink-400">
          手机可上下滑动完整阅读两页；需要纸质打印请下载白底版。
        </p>
      </div>
      <div class="flex w-full flex-wrap gap-2 sm:w-auto sm:justify-end">
        <a
          href={resumePdfPrint}
          class="btn-primary w-full justify-center sm:w-auto"
          download={`王子健_简历_打印白底.pdf`}
        >
          下载打印白底 PDF
        </a>
        <a href={resumePdf} class="btn-secondary w-full justify-center sm:w-auto" target="_blank" rel="noopener noreferrer">
          打开电子版 PDF
        </a>
        <a href="/resume/" class="btn-ghost w-full justify-center sm:w-auto">返回简历页</a>
      </div>
    </div>

    <!-- Image stack: reliable full-content preview on mobile -->
    <div class="mt-5 space-y-4 sm:mt-6 sm:space-y-5" id="resume-preview-pages">
      {
        previewPages.map((page, index) => (
          <figure class="overflow-hidden rounded-xl border border-ink-200/80 bg-[#f5f4ed] shadow-sm dark:border-ink-700 sm:rounded-2xl">
            <figcaption class="border-b border-ink-200/70 px-3 py-2 text-xs text-ink-500 dark:border-ink-700 dark:text-ink-400 sm:px-4">
              第 {index + 1} / {previewPages.length} 页
            </figcaption>
            <img
              src={page.src}
              alt={page.alt}
              width="1191"
              height="1684"
              class="block h-auto w-full"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          </figure>
        ))
      }
    </div>

    <div class="mt-6 flex flex-col gap-2 sm:hidden">
      <a href={resumePdfPrint} class="btn-primary w-full justify-center" download={`王子健_简历_打印白底.pdf`}>
        下载打印白底 PDF
      </a>
      <a href={resumePdf} class="btn-secondary w-full justify-center" target="_blank" rel="noopener noreferrer">
        打开电子版 PDF 文件
      </a>
    </div>

    <p class="mt-5 text-center text-xs leading-relaxed text-ink-500">
      预览为电子版米白排版截图，便于手机完整阅读。打印请使用白底 PDF，避免背景耗墨。
    </p>
  </div>
</BaseLayout>
