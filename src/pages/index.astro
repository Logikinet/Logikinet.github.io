---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FlagshipProjectBay from "@/components/FlagshipProjectBay.astro";
import ProjectStackCarousel from "@/components/ProjectStackCarousel.astro";
import PostCard from "@/components/PostCard.astro";
import TextType from "@/components/TextType.astro";
import TrueFocus from "@/components/TrueFocus.astro";
import { SITE, FOCUS_AREAS, ACHIEVEMENTS } from "@/config";
import {
  getFlagshipProject,
  getListedProjects,
  getMoreProjects,
} from "@/data/projects";
import { tools } from "@/data/tools";
import { labItems } from "@/data/lab";
import { resourceSections } from "@/data/resources";
import { getPublishedPosts } from "@/utils/blog";

const flagshipProject = getFlagshipProject();
const moreProjects = flagshipProject
  ? getMoreProjects(flagshipProject.id, 6)
  : getMoreProjects("", 6);
const listedProjects = getListedProjects();
const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);

const stats = [
  { value: String(listedProjects.length), label: "项目实践", href: "#projects" },
  { value: String(allPosts.length), label: "技术文章", href: "#latest-posts" },
  { value: String(tools.length), label: "本地工具", href: "#tools" },
  ...(labItems.length > 0
    ? [{ value: String(labItems.length), label: "实验室 Demo", href: "#lab" }]
    : []),
] as const;

const heroTags = ["Agent & Harness", "HarmonyOS", "Cangjie", "AI Apps", "ROS & IoT"] as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  author: {
    "@type": "Person",
    name: SITE.name,
    url: SITE.url,
    sameAs: [SITE.github],
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero-surface" aria-labelledby="hero-title">
    <div class="container-page section-space !pb-6 sm:!pb-8 lg:!pb-10">
      <div class="hero-kicker">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-aqua-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-aqua-500"></span>
        </span>
        <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-ink-500 dark:text-ink-400">
          {SITE.title}
        </span>
        <span class="text-ink-300 dark:text-ink-600" aria-hidden="true">·</span>
        <span>王子健 (Logikinet)</span>
      </div>

      <div class="mt-6 flex items-center gap-3.5">
        <img
          src="/assets/logo-128.png?v=20260723b"
          alt=""
          width="48"
          height="48"
          class="h-10 w-10 sm:h-12 sm:w-12 shrink-0 rounded-2xl object-contain drop-shadow-md transition-transform hover:scale-105"
        />
        <h1
          id="hero-title"
          class="text-3xl font-bold tracking-tight text-ink-900 sm:text-5xl lg:text-6xl dark:text-ink-50"
          style="font-family: var(--font-display)"
        >
          <TrueFocus
            sentence="Hi, I'm 王子健"
            separator=" "
            manualMode={false}
            blurAmount={4}
            borderColor="var(--color-aqua-500)"
            glowColor="rgb(47 168 154 / 0.6)"
            animationDuration={0.5}
            pauseBetweenAnimations={1}
            wordClassName="hero-focus-word"
          />
        </h1>
      </div>

      <p class="mt-4 flex flex-wrap items-center gap-2 text-lg sm:text-xl font-normal text-ink-600 dark:text-ink-300">
        <span>Building AI systems & fullstack apps as a</span>
        <span
          class="inline-flex min-h-[1.75em] items-center rounded-lg border border-ink-200/80 bg-white/80 px-2.5 py-0.5 font-mono text-base sm:text-lg font-medium italic text-ink-800 shadow-xs backdrop-blur-xs dark:border-ink-700/80 dark:bg-ink-800/80 dark:text-ink-100"
        >
          <TextType
            className="text-aqua-600 dark:text-aqua-400"
            text={[
              "<developer />",
              "<agent_builder />",
              "<fullstack_dev />",
              "<harmonyos_dev />",
              "<open_sourcer />",
            ]}
            typingSpeed={75}
            deletingSpeed={40}
            pauseDuration={1600}
            initialDelay={500}
            showCursor={true}
            cursorCharacter="|"
            cursorBlinkDuration={0.5}
            loop={true}
            startOnVisible={true}
          />
        </span>
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="/projects/" class="btn-primary">查看项目</a>
        <a href="/blog/" class="btn-secondary">阅读博客</a>
        <a
          href={SITE.github}
          class="btn-ghost !px-3"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub（新窗口打开）"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"
            />
          </svg>
          <span>GitHub</span>
        </a>
      </div>

      <ul class="mt-8 flex flex-wrap gap-2" aria-label="技术方向标签">
        {
          heroTags.map((tag) => (
            <li>
              <span class="chip">{tag}</span>
            </li>
          ))
        }
      </ul>

      <div class="stat-bar" aria-label="站点概览">
        {
          stats.map((s) => (
            <a href={s.href} class="stat-item group">
              <span class="sr-only">{s.label}</span>
              <p class="stat-value">{s.value}</p>
              <p class="stat-label">{s.label}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Flagship project bay (replaces old featured grid) -->
  {
    flagshipProject && (
      <section
        id="projects"
        class="scroll-mt-header flagship-follow pt-8 pb-10 sm:pt-10 sm:pb-12 lg:pt-14 lg:pb-14"
        aria-label="旗舰项目展示舱"
      >
        <div class="container-page">
          <FlagshipProjectBay project={flagshipProject} />
        </div>
      </section>
    )
  }

  <!-- More projects — Travel2-style stacked carousel -->
  <section class="scroll-mt-header pb-16 sm:pb-20 lg:pb-24" aria-labelledby="more-projects">
    <div class="container-page">
      <div class="mb-7 flex items-end justify-between gap-4 sm:mb-8">
        <div>
          <p class="label-meta">Projects</p>
          <h2 id="more-projects" class="section-heading mt-2.5">更多项目</h2>
          <p class="mt-2 max-w-lg text-sm text-ink-500 dark:text-ink-400">
            其余精选实践，左右滑动或点两侧卡片浏览。
          </p>
        </div>
        <a href="/projects/" class="section-link shrink-0">全部项目 →</a>
      </div>
      {moreProjects.length > 0 && <ProjectStackCarousel projects={moreProjects} />}
    </div>
  </section>

  <!-- Focus -->
  <section class="band section-space" aria-labelledby="focus-areas">
    <div class="container-page">
      <div class="mb-8">
        <p class="label-meta">Focus</p>
        <h2 id="focus-areas" class="section-heading mt-2.5">技术方向</h2>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 sm:gap-5" role="list">
        {
          FOCUS_AREAS.map((area) => (
            <li>
              <article class="card h-full !p-5 sm:!p-5">
                <span
                  class="mb-7 block h-px w-10 bg-aqua-500/70 dark:bg-aqua-400/70"
                  aria-hidden="true"
                />
                <h3 class="text-lg font-semibold tracking-tight text-ink-900 dark:text-ink-50">
                  {area.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
                  {area.description}
                </p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Latest posts -->
  <section
    id="latest-posts"
    class="scroll-mt-header section-space"
    aria-labelledby="latest-posts-heading"
  >
    <div class="container-page">
      <div class="mb-9 flex items-end justify-between gap-4">
        <div>
          <p class="label-meta">Blog</p>
          <h2 id="latest-posts-heading" class="section-heading mt-2.5">最新文章</h2>
        </div>
        <a href="/blog/" class="section-link shrink-0">全部文章 →</a>
      </div>
      <div class="grid gap-5 sm:gap-6">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- Explore: tools + resources + lab in one band -->
  <section
    id="explore"
    class="scroll-mt-header band section-space"
    aria-labelledby="explore-heading"
  >
    <div class="container-page">
      <div class="mb-8">
        <p class="label-meta">Explore</p>
        <h2 id="explore-heading" class="section-heading mt-2.5">继续探索</h2>
      </div>

      <div class="grid gap-6 lg:grid-cols-3 lg:gap-5">
        <div id="tools" class="scroll-mt-header">
          <div class="mb-3 flex items-center justify-between gap-2">
            <h3 class="text-base font-semibold text-ink-900 dark:text-ink-50">在线工具</h3>
            <a href="/tools/" class="section-link text-xs">全部 →</a>
          </div>
          <ul class="space-y-2.5">
            {
              tools.slice(0, 3).map((tool) => (
                <li>
                  <a href={tool.href} class="card card-interactive !p-3.5 block no-underline">
                    <p class="text-sm font-medium text-ink-900 dark:text-ink-50">{tool.title}</p>
                    <p class="mt-1 line-clamp-2 text-xs text-ink-500 dark:text-ink-400">
                      {tool.summary}
                    </p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div id="resources" class="scroll-mt-header">
          <div class="mb-3 flex items-center justify-between gap-2">
            <h3 class="text-base font-semibold text-ink-900 dark:text-ink-50">资源库</h3>
            <a href="/resources/" class="section-link text-xs">进入 →</a>
          </div>
          <ul class="space-y-2.5">
            {
              resourceSections.slice(0, 4).map((section) => (
                <li>
                  <a href={section.href} class="card card-interactive !p-3.5 block no-underline">
                    <p class="text-sm font-medium text-ink-900 dark:text-ink-50">
                      {section.shortTitle}
                    </p>
                    <p class="mt-1 line-clamp-2 text-xs text-ink-500 dark:text-ink-400">
                      {section.description}
                    </p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div id="lab" class="scroll-mt-header">
          <div class="mb-3 flex items-center justify-between gap-2">
            <h3 class="text-base font-semibold text-ink-900 dark:text-ink-50">实验室</h3>
            <a href="/lab/" class="section-link text-xs">全部 →</a>
          </div>
          {
            labItems.length > 0 ? (
              <ul class="space-y-2.5">
                {labItems.slice(0, 3).map((item) => (
                  <li>
                    <a href={item.href} class="card card-interactive !p-3.5 block no-underline">
                      <p class="text-sm font-medium text-ink-900 dark:text-ink-50">{item.title}</p>
                      <p class="mt-1 line-clamp-2 text-xs text-ink-500 dark:text-ink-400">
                        {item.summary}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-ink-500">暂无公开 Demo。</p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights + contact -->
  <section class="section-space" aria-labelledby="achievements">
    <div class="container-page grid gap-8 lg:grid-cols-5 lg:gap-10">
      <div class="lg:col-span-3">
        <p class="label-meta">Highlights</p>
        <h2 id="achievements" class="section-heading mt-2.5">获奖与成果摘要</h2>
        <ul class="mt-7 space-y-3.5">
          {
            ACHIEVEMENTS.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-ink-700 dark:text-ink-200">
                <span
                  class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-aqua-500 ring-4 ring-aqua-500/10"
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card lg:col-span-2">
        <p class="label-meta">Contact</p>
        <h2 class="mt-2.5 text-xl font-semibold tracking-tight">GitHub 与联系</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
          开源与实验代码集中在 GitHub。如需交流 Agent 工程、鸿蒙/仓颉或项目合作，欢迎通过 GitHub 联系。
        </p>
        <div class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
          <a href={SITE.github} class="btn-primary" target="_blank" rel="noopener noreferrer">
            @{SITE.githubUser}
          </a>
          <a href="/about/" class="btn-secondary">关于我</a>
          <a href="/resume/" class="btn-ghost">在线简历</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
